# Copia a .env.local y llena con la config web de tu proyecto Firebase
# (Consola de Firebase › Configuración del proyecto › Tus apps › App web).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# true = usar los emuladores locales (bun run emulators) en vez del proyecto real.
NEXT_PUBLIC_USE_EMULATORS=true

# Solo scripts del servidor (seed, alta de admin). Ruta a la clave de cuenta de servicio.
# NUNCA se commitea. Con emuladores no hace falta.
GOOGLE_APPLICATION_CREDENTIALS=

# Avisos push de citas nuevas (D035): la clave PÚBLICA VAPID, la misma que VAPID_PUBLIC_KEY
# del bot (bot/.env). Vacía = la campana explica que faltan por configurar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# QA → .env.test.local (gitignored). Cuentas que SOLO existen en los emuladores: las crea
# `bun run qa:local` en cada corrida. Valores inventados; nunca los de producción.
ADMIN_EMAIL_TEST=
ADMIN_PASSWORD_TEST=
EMAIL_TEST=
PASSWORD_TEST=
