# Postgres en el VPS (D044). En desarrollo NO se edita a mano: `bun run vps:env inversiones_js_dev`
# escribe DATABASE_URL y DIRECT_URL en .env.development.local (sobrevive a `vercel env pull`).
# DIRECT_URL necesita el túnel: ssh -N -L 5433:127.0.0.1:5432 kit-vps
DATABASE_URL=
DIRECT_URL=

# Better Auth. Secreto aleatorio de 32 bytes (uno por entorno, nunca el de producción en local).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Correo (D040): Brevo por SMTP. Sin SMTP_HOST no se envía (solo queda en el log).
# En QA: SMTP_HOST=localhost y SMTP_PORT=1025 con Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Usuarios importados de Firebase Auth (migración al VPS): parámetros del hash del proyecto
# (Consola de Firebase › Authentication › ⋮ › Parámetros de hash de contraseñas).
FIREBASE_HASH_SIGNER_KEY=
FIREBASE_HASH_SALT_SEPARATOR=
FIREBASE_HASH_ROUNDS=
FIREBASE_HASH_MEM_COST=

# Avisos push de citas nuevas (D035): la clave PÚBLICA VAPID, la misma que VAPID_PUBLIC_KEY
# del bot (bot/.env). Vacía = la campana explica que faltan por configurar.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Solo para exportar los datos de Firestore en la migración (scripts de Firebase). NUNCA se commitea.
GOOGLE_APPLICATION_CREDENTIALS=

# QA → .env.test.local (gitignored). Valores inventados; nunca los de producción.
ADMIN_EMAIL_TEST=
ADMIN_PASSWORD_TEST=
EMAIL_TEST=
PASSWORD_TEST=
