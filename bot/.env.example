# Copiar a bot/.env en el VPS (nunca a git) y completar.

# La misma clave AUTHENTICATION_API_KEY de Evolution API.
EVOLUTION_API_KEY=
# Nombre de la instancia de WhatsApp en Evolution.
EVOLUTION_INSTANCIA=inversiones-js
# URL interna de Evolution en la red automation-net.
EVOLUTION_URL=http://evolution-api:8080
# URL de Evolution desde el VPS (para scripts/vincular.sh).
EVOLUTION_LOCAL=http://localhost:8080

# Secreto en la ruta del webhook (genera uno con: openssl rand -hex 16).
WEBHOOK_TOKEN=

# ID del calendario de citas (Configuración del calendario › Integrar el calendario).
GOOGLE_CALENDAR_ID=

# Proyecto de Firebase del panel, solo si NO es el mismo de la cuenta de servicio.
FIREBASE_PROJECT_ID=

# Números que reciben avisos de nuevas citas/solicitudes (58412…, separados por coma). Opcional.
ASESOR_NUMEROS=

# Pausa "escribiendo…" antes de cada respuesta (ms, aleatoria entre ambos).
DEMORA_MIN_MS=2500
DEMORA_MAX_MS=6000

# Horas que Gaby se calla en un chat después de que escribes tú a mano en él.
HORAS_PAUSA=12
# Frenos anti-baneo: respuestas máximas por chat cada 10 min y en total por hora.
MAX_POR_CHAT_10MIN=8
MAX_POR_HORA=60
