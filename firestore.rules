rules_version = '2';

// D003: solo los usuarios con documento admins/{uid} leen o escriben el catálogo.
// El chatbot NO pasa por estas reglas: lee con el Admin SDK desde su servidor (D005).
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function esAdmin() {
      return autenticado()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // D025: nombre de marca = id de marcas/{nombre}. Mismo patrón que lib/catalogo/marcas.ts.
    function marcaValida(m) {
      return m is string && m.size() >= 1 && m.size() <= 30
        && m.matches('^[A-Z0-9ÁÉÍÓÚÜÑ][A-Z0-9ÁÉÍÓÚÜÑ &.+-]*$');
    }

    // existsAfter: en un lote (renombrar marca) ve la marca nueva creada en el mismo lote.
    function marcaRegistrada(m) {
      return existsAfter(/databases/$(database)/documents/marcas/$(m));
    }

    function productoValido(p) {
      return p.keys().hasOnly([
          'marca', 'nombre', 'variante', 'inicial', 'cuota', 'numeroCuotas',
          'cantidad', 'activo', 'orden', 'actualizadoEn', 'actualizadoPor'
        ])
        && p.keys().hasAll([
          'marca', 'nombre', 'variante', 'inicial', 'cuota', 'numeroCuotas',
          'cantidad', 'activo', 'orden'
        ])
        && marcaValida(p.marca)
        && p.nombre is string && p.nombre.size() >= 1 && p.nombre.size() <= 80
        && p.variante is string && p.variante.size() <= 20
        && p.inicial is number && p.inicial >= 0 && p.inicial <= 100000
        && p.cuota is number && p.cuota >= 0 && p.cuota <= 100000
        && p.numeroCuotas is int && p.numeroCuotas >= 1 && p.numeroCuotas <= 48
        && p.cantidad is int && p.cantidad >= 0 && p.cantidad <= 100000
        && p.activo is bool
        && p.orden is number;
    }

    // Toda escritura desde el panel deja huella de quién y cuándo.
    function conHuella(p) {
      return p.actualizadoPor == request.auth.uid
        && p.actualizadoEn == request.time;
    }

    // D030: póliza RCV. Mismos límites que lib/rcv/validacion.ts.
    function categoriasValidas(c) {
      return c is list && c.size() >= 1 && c.size() <= 3
        && c.hasOnly(['publico', 'privado', 'extranjeras']);
    }

    function planRcvValido(p) {
      return p.keys().hasOnly([
          'clase', 'descripcion', 'precioEur', 'categorias', 'financiamiento',
          'activo', 'orden', 'actualizadoEn', 'actualizadoPor'
        ])
        && p.keys().hasAll([
          'clase', 'descripcion', 'precioEur', 'categorias', 'financiamiento',
          'activo', 'orden'
        ])
        && p.clase is string && p.clase.size() >= 1 && p.clase.size() <= 40
        && p.descripcion is string && p.descripcion.size() >= 1 && p.descripcion.size() <= 120
        && (p.precioEur == null
          || (p.precioEur is number && p.precioEur >= 0 && p.precioEur <= 100000))
        && categoriasValidas(p.categorias)
        && p.financiamiento is bool
        && p.activo is bool
        && p.orden is number;
    }

    function listaRequisitos(l) {
      return l is list && l.size() >= 1 && l.size() <= 20;
    }

    // Tasas y requisitos se guardan por separado (merge): cada uno es opcional.
    // D034: una sola lista `requisitosGenerales`; `requisitos` (por categoría) es de antes y el
    // panel lo borra al guardar los requisitos.
    function configRcvValida(c) {
      return c.keys().hasOnly([
          'tasaUsd', 'tasaBs', 'tasaCop', 'fuenteBs', 'fuenteUsd', 'fuenteCop',
          'requisitosGenerales', 'requisitos',
          'actualizadoEn', 'actualizadoPor'
        ])
        && (!('tasaUsd' in c) || (c.tasaUsd is number && c.tasaUsd > 0 && c.tasaUsd <= 1000))
        && (!('tasaBs' in c) || (c.tasaBs is number && c.tasaBs > 0 && c.tasaBs <= 1000000000))
        && (!('tasaCop' in c) || (c.tasaCop is number && c.tasaCop > 0 && c.tasaCop <= 1000000))
        && (!('fuenteBs' in c) || c.fuenteBs in ['bcv', 'manual'])
        // D036: dólares y pesos, de mercado (automática) o manual.
        && (!('fuenteUsd' in c) || c.fuenteUsd in ['mercado', 'manual'])
        && (!('fuenteCop' in c) || c.fuenteCop in ['mercado', 'manual'])
        && (!('requisitosGenerales' in c) || listaRequisitos(c.requisitosGenerales))
        && (!('requisitos' in c) || c.requisitos is map);
    }

    match /planesRcv/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin()
        && planRcvValido(request.resource.data)
        && conHuella(request.resource.data);
    }

    // Solo configuracion/rcv; el resto de `configuracion` (horario) sigue cerrado al panel.
    match /configuracion/rcv {
      allow read: if esAdmin();
      allow create, update: if esAdmin()
        && configRcvValida(request.resource.data)
        && conHuella(request.resource.data);
      allow delete: if false;
    }

    // Las escribe el bot con el Admin SDK (no pasa por reglas); el panel solo lee y borra.
    match /solicitudesRcv/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if false;
    }

    // D032: clientes con financiamiento. Mismos límites que lib/financiamiento/validacion.ts.
    function fecha(f) {
      // Rango grueso (D042): corta años de dos dígitos ("0026") y fechas absurdas.
      return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && f >= '2000-01-01' && f <= '2099-12-31';
    }

    function texto(t, min, max) {
      return t is string && t.size() >= min && t.size() <= max;
    }

    // Las reglas no recorren listas: se limita el tamaño; el contenido lo arma el panel.
    function planPagosValido(p) {
      return p is map
        && p.keys().hasOnly(['inicial', 'frecuencia', 'cuotas'])
        && p.keys().hasAll(['inicial', 'frecuencia', 'cuotas'])
        && p.inicial is number && p.inicial >= 0 && p.inicial <= 100000
        && p.frecuencia in ['semanal', 'quincenal', 'mensual']
        && p.cuotas is list && p.cuotas.size() >= 1 && p.cuotas.size() <= 60;
    }

    function datosPersonales(c) {
      return texto(c.nombre, 1, 80)
        && texto(c.cedula, 0, 20)
        && texto(c.telefono, 1, 30)
        && texto(c.notas, 0, 500);
    }

    function clienteCelularValido(c) {
      return c.keys().hasOnly([
          'nombre', 'cedula', 'telefono', 'equipo', 'notas', 'pagos',
          'actualizadoEn', 'actualizadoPor'
        ])
        && c.keys().hasAll(['nombre', 'cedula', 'telefono', 'equipo', 'notas', 'pagos'])
        && datosPersonales(c)
        && texto(c.equipo, 1, 80)
        && planPagosValido(c.pagos);
    }

    function clienteRcvValido(c) {
      return c.keys().hasOnly([
          'nombre', 'cedula', 'telefono', 'correo', 'direccion', 'vehiculo', 'placa', 'notas',
          'emision', 'vence', 'recordatorio30', 'recordatorio3', 'pagos',
          'actualizadoEn', 'actualizadoPor'
        ])
        && c.keys().hasAll([
          'nombre', 'cedula', 'telefono', 'correo', 'direccion', 'vehiculo', 'placa', 'notas',
          'emision', 'vence', 'recordatorio30', 'recordatorio3', 'pagos'
        ])
        && datosPersonales(c)
        && texto(c.correo, 0, 120)
        && texto(c.direccion, 0, 200)
        && texto(c.vehiculo, 1, 120)
        && texto(c.placa, 0, 12)
        && ((c.emision == null && c.vence == null) || (fecha(c.emision) && fecha(c.vence)))
        && c.recordatorio30 is bool
        && c.recordatorio3 is bool
        && (c.pagos == null || planPagosValido(c.pagos));
    }

    match /clientesCelulares/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin()
        && clienteCelularValido(request.resource.data)
        && conHuella(request.resource.data);
    }

    // El bot (Admin SDK) además marca recordatorio30/recordatorio3 al mandar los avisos (D033).
    match /clientesRcv/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin()
        && clienteRcvValido(request.resource.data)
        && conHuella(request.resource.data);
    }

    // D035: suscripciones Web Push de los teléfonos del panel. El bot las lee (Admin SDK) para
    // avisar de citas nuevas y borra las que el navegador dio de baja.
    match /suscripcionesPush/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasOnly(['endpoint', 'p256dh', 'auth', 'uid', 'dispositivo', 'creadaEn'])
        && request.resource.data.keys().hasAll(['endpoint', 'p256dh', 'auth', 'uid', 'dispositivo', 'creadaEn'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.creadaEn == request.time
        && texto(request.resource.data.endpoint, 1, 1000)
        && request.resource.data.endpoint.matches('https://.+')
        && texto(request.resource.data.p256dh, 1, 200)
        && texto(request.resource.data.auth, 1, 100)
        && texto(request.resource.data.dispositivo, 0, 120);
    }

    match /admins/{uid} {
      // Cada quien puede comprobar si es admin; la lista se gestiona solo desde consola/Admin SDK.
      allow read: if autenticado() && request.auth.uid == uid;
      allow write: if false;
    }

    match /productos/{id} {
      allow read: if esAdmin();
      allow create: if esAdmin()
        && productoValido(request.resource.data)
        && conHuella(request.resource.data)
        && marcaRegistrada(request.resource.data.marca);
      // Si la marca no cambia no se exige que esté registrada: los productos de antes de D025
      // siguen editándose aunque su marca aún no tenga documento.
      allow update: if esAdmin()
        && productoValido(request.resource.data)
        && conHuella(request.resource.data)
        && (request.resource.data.marca == resource.data.marca
          || marcaRegistrada(request.resource.data.marca));
      allow delete: if esAdmin();
    }

    match /marcas/{nombre} {
      allow read: if esAdmin();
      // Solo crear: el id es el nombre, así que sobrescribir = duplicar. Renombrar es
      // crear la nueva + borrar la vieja (en lote, ver renombrarMarca).
      allow create: if esAdmin()
        && request.resource.data.keys().hasOnly(['nombre', 'actualizadoEn', 'actualizadoPor'])
        && request.resource.data.nombre == nombre
        && marcaValida(nombre)
        && conHuella(request.resource.data);
      allow update: if false;
      // Que no tenga productos lo comprueba el panel: las reglas no pueden consultar.
      allow delete: if esAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
