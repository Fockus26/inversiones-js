rules_version = '2';

// Migración al VPS (D044, corte del 2026-11-10): los datos viven en Postgres. Firestore queda
// 30 días sin escrituras como respaldo para volver atrás; solo los admins pueden leerlo (una
// pestaña con el panel viejo abierto). Borrar el proyecto lo decide César tras comparar datos.
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /{documento=**} {
      allow read: if esAdmin();
      allow write: if false;
    }
  }
}
