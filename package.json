{
  "name": "inversiones-js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test ./tests/unit --pass-with-no-tests",
    "test:related": "bun scripts/test-related.ts --dir=tests/unit",
    "shots": "node scripts/pr-screenshots.ts .pr-shots.json",
    "shots:publish": "bash scripts/publish-pr-shots.sh .pr-shots",
    "context:backup": "bash scripts/context-backup.sh",
    "context:restore": "bash scripts/context-backup.sh --restore",
    "emulators": "firebase emulators:start --project demo-inversiones-js",
    "emulators:test": "bun test ./tests/rules",
    "seed:emulador": "bun scripts/seed-emulador.ts",
    "seed:produccion": "bun scripts/seed-produccion.ts",
    "admin:crear": "bun scripts/crear-admin.ts",
    "qa:local": "node scripts/qa-local.ts",
    "vps:env": "bun scripts/vps-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "usuarios:importar": "bun scripts/importar-usuarios.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "better-auth": "^1.7.19",
    "class-variance-authority": "^0.7.1",
    "drizzle-orm": "^0.45.4",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.4.2",
    "@electric-sql/pglite": "^0.5.16",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "firebase-tools": "15.32.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
