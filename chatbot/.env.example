# Copia a .env y llena. NUNCA subas .env ni la clave JSON a git.

# Clave JSON de la cuenta de servicio de SOLO LECTURA (roles/datastore.viewer, D024).
GOOGLE_APPLICATION_CREDENTIALS=/home/bot/claves/chatbot-lectura.json

# Número del bot con código de país, solo dígitos (Venezuela: 58 + número sin el 0).
# Si lo pones, se vincula con código de 8 letras; si lo dejas vacío, se muestra un QR.
NUMERO_BOT=

# Tu número personal: te llega un aviso cuando un cliente pide asesor. Opcional.
NUMERO_AVISOS=

# Para PROBAR: el bot solo responde a estos números (coma). Vacío = responde a todos.
SOLO_NUMEROS=

# Horas que el bot se calla en un chat tras pedir asesor o escribir tú desde el teléfono.
HORAS_PAUSA=12
# Frenos anti-baneo.
MAX_POR_CHAT_10MIN=6
MAX_POR_HORA=80

# marcar = muestra "(agotado)"; ocultar = no muestra los de cantidad 0.
AGOTADOS=marcar
ZONA_HORARIA=America/Caracas
CARPETA_DATOS=./datos

# Solo para probar contra el emulador local (no en el VPS):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-inversiones-js
