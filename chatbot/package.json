{
  "name": "inversiones-js-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/index.ts --target=node --outdir=dist --packages=external",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./tests",
    "dev": "bun run build && node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "firebase-admin": "^14.5.0",
    "pino": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5"
  }
}
